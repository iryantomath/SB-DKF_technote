%%% Code By Iryanto et al. %%%
%%% Sensitivity-Based Dual Kalman Filter for System Identification -- Duffing OScillator %%%


clc; clear; close all;
%% =========================================================
% SETTINGS
%% =========================================================
dt = 0.005;
T  = 10;
N  = round(T/dt);
t  = (0:N-1)*dt;

MC = 50;   % Monte Carlo runs

%% TRUE PARAMETERS
k1 = -1.0;
alpha_true = 1.0;
c_true = 0.3;   
b_true = 1.0;
mass = 1.;

%% assumed to be known 
b_true = b_true/mass; % assummed to be known

%% unknown parameter values
k1 = k1/mass;
alpha_true = alpha_true/mass;
c_true = c_true/mass;


% true parameter values
theta_true = [k1; c_true; alpha_true];
theta_true_mat = repmat(theta_true,1,N);

%% NOISE
sigma_w = 1/100; 
sigma_v = 10/100; 
sigma = [sigma_w sigma_v]
%% INPUT (persistent excitation)
u = 0.3*cos(1.25*t);
%% MODEL MATRICES
nx = 2; np = 3;
Ad = [1 dt; 0 1];
Bd = [0; b_true*dt];
C  = eye(2); %[1 0];

Qx = 1e-4*eye(2);
R  = 0.01*eye(2);
Rt = 0.1*eye(2); % karena vk + epsilonk

%% FORGETTING FACTORS
lambda_x     = 0.999;
lambda_theta = 0.99999;
lambda       = lambda_theta;   % AKF (single)

% ===== trajectory mean =====
Xtrue_mean = zeros(nx,N);

Xdkf_mean  = zeros(nx,N);
Xakf_mean  = zeros(nx,N);

Thdkf_mean = zeros(np,N);
Thakf_mean = zeros(np,N);

% ===== global RMSE =====
rmse_x_DKF  = zeros(MC,1);
rmse_x_AKF  = zeros(MC,1);

rmse_th_DKF = zeros(MC,1);
rmse_th_AKF = zeros(MC,1);

% ===== RMSE each parameter =====
rmse_theta_DKF_each = zeros(MC,np);
rmse_theta_AKF_each = zeros(MC,np);

% ===== RMSE each state =====
rmse_x_DKF_each = zeros(MC,np);
rmse_x_AKF_each = zeros(MC,np);


% ===== final parameter =====
theta_final_DKF = zeros(MC,np);
theta_final_AKF = zeros(MC,np);

%% =========================================================
% MONTE CARLO LOOP
%% =========================================================
for mc = 1:MC
    %% TRUE STATE GENERATION (RK4)
    f = @(x,u,th) [ ...
        x(2);
        -th(1)*x(1) - th(2)*x(2) - th(3)*x(1)^3 + b_true*u ];
    % Initial value of state
    x_true = zeros(2,N);
    x_true(:,1) = [1;0];
    
    for k=1:N-1
        k1r = f(x_true(:,k),u(k),theta_true);
        k2r = f(x_true(:,k)+0.5*dt*k1r,u(k),theta_true);
        k3r = f(x_true(:,k)+0.5*dt*k2r,u(k),theta_true);
        k4r = f(x_true(:,k)+dt*k3r,u(k),theta_true);
        % adding noise model
        x_det = x_true(:,k) + dt/6*(k1r+2*k2r+2*k3r+k4r);
        std_x = std(x_det,0,2);
        x_true(:,k+1) = x_det + sigma_w*std_x.*randn(2,1) ;
    end
    %% Measurement (partial)
    y = zeros(2,N);
    std_x = std(x_true,0,2);   % std each state
    for k = 1:N
        y(:,k)   = x_true(:,k) + sigma_v*std_x.*randn(2,1);
    end
    %% Initialization of each algorithm
    % SB - DKF
    xhat_dkf = [0.;0.];      thetahat_dkf = [0.;0.;0.]; %[0.;0.];
    Px = 10*eye(nx);     Pt = 100*eye(np);
    Gamma = zeros(nx,np);
    % AKF
    xhat_akf = xhat_dkf;     thetahat_akf = thetahat_dkf;
    Px2 = Px;    State = Pt;
    Upsilon = zeros(nx,np);
    
    %% =====================================================
    % STORAGE CURRENT MC
    %% =====================================================
    Xdkf  = zeros(nx,N);
    Xakf  = zeros(nx,N);

    Thdkf = zeros(np,N);
    Thakf = zeros(np,N);

    %% =====================================================
    % MAIN LOOP
    %% =====================================================
    for k=1:N
        %% measurement data
        yk = y(:,k); 

        %% regressor from measurement Psi
        Psi_dkf = dt*[0 0 0; -yk(1) -yk(2) -yk(1)^3];
        Psi_akf = Psi_dkf;
        %% ======== SB-DKF =========        
        % Predict state and parameter via (12) - (13)
        xpred = Ad*xhat_dkf + Bd*u(k) + Psi_dkf*thetahat_dkf;
        thetahat_dkf = thetahat_dkf;
        % Predict covariance via (14) - (15)
        Px = (1/lambda_x)*(Ad*Px*Ad') + Qx;
        Pt = (1/lambda_theta)*Pt;        
        % Predict the sensitivity matrix via (16)
        Gamma = Ad*Gamma + Psi_dkf;  
        % Compute innovation (17)
        innovation = yk - C*xpred;
        % Compute gains (20)–(21)
        Sx = C*Px*C' + R;
        St = C*Gamma*Pt*Gamma'*C' + Rt;
        Kx = Px*C'*inv(Sx);
        Kt = Pt*Gamma'*C'*inv(St); 
        % Update the sensitivity via (22)
        Gamma = (eye(nx)-Kx*C)*Gamma;
        % Update the parameter via (23) and the state via (24)
        xhat_dkf = xpred + (Kx + Gamma*Kt)*innovation;
        thetahat_dkf = thetahat_dkf + Kt*innovation;
        % Update the covariances via (25)–(26)
        Px = (eye(nx)-Kx*C)*Px;
        Pt = (eye(np)-Kt*C*Gamma)*Pt;
        %%% =========================================== %%%  
        
        %% =========== AKF ===========
        % Compute the estimation gain via (26) - (34) (Hasan,2024) or via
        % (5a) - (5d) (5e) - (5i) (Zhang,2018)
        %%%%%%%%%%%%%%%%%%%%%%%%%%% 
        Px2 = Ad*Px2*Ad' + Qx;
        SigmaP = C*Px2*C' + R;
        Kx2 = Px2*C'*inv(SigmaP);
        Px2 = (eye(nx)-Kx2*C)*Px2;
        %%%%%%%%%%%%%%%%%%%%%%%%%%%%% 
        Gamma_old = Upsilon;   % save Gamma(k-1)          
        Omega = C*Ad*Upsilon + C*Psi_akf; %%% switch:: compute Omega first then Gamma since Gamma(k-1)
        Upsilon = (eye(nx)-Kx2*C)*Ad*Upsilon + (eye(nx)-Kx2*C)*Psi_akf;
        Lambda = inv(lambda*SigmaP + Omega*State*Omega');
        Zeta = State*Omega'*Lambda;
        State = (1/lambda)*State ...
            - (1/lambda)*State*Omega'*Lambda*Omega*State;
        % Calculate innovation via (25)
        ytilde = yk - C*(Ad*xhat_akf + Bd*u(k) + Psi_akf*thetahat_akf);
        % Estimate state and parameter (23) - (24)
        theta_old = thetahat_akf;
        thetahat_akf = thetahat_akf + Zeta*ytilde;
        xhat_akf = Ad*xhat_akf + Bd*u(k) + Psi_akf*theta_old + Kx2*ytilde + Upsilon*(thetahat_akf-theta_old);        
        %%% =========================================== %%%
        
            %% =================================================
        % STORE
        %% =================================================
        Xdkf(:,k) = xhat_dkf;
        Xakf(:,k) = xhat_akf;

        Thdkf(:,k) = thetahat_dkf;
        Thakf(:,k) = thetahat_akf;   
    end
    
    %% =====================================================
    % MEAN TRAJECTORY
    %% =====================================================
    Xtrue_mean = Xtrue_mean + x_true;

    Xdkf_mean = Xdkf_mean + Xdkf;
    Xakf_mean = Xakf_mean + Xakf;

    Thdkf_mean = Thdkf_mean + Thdkf;
    Thakf_mean = Thakf_mean + Thakf;

    %% =====================================================
    % GLOBAL RMSE
    %% =====================================================
    % ===== state =====
    rmse_x_DKF(mc) = sqrt(mean((Xdkf(:)-x_true(:)).^2));
    rmse_x_AKF(mc) = sqrt(mean((Xakf(:)-x_true(:)).^2));

    % ===== parameter =====
    rmse_th_DKF(mc) = sqrt(mean((Thdkf(:)-theta_true_mat(:)).^2));
    rmse_th_AKF(mc) = sqrt(mean((Thakf(:)-theta_true_mat(:)).^2));

    %% =====================================================
    % RMSE EACH PARAMETER AND STATE
    %% =====================================================
    for p=1:np
        rmse_theta_DKF_each(mc,p) = sqrt(mean((Thdkf(p,:) - theta_true_mat(p)).^2));
        rmse_theta_AKF_each(mc,p) = sqrt(mean((Thakf(p,:) - theta_true_mat(p)).^2));
    end
    
    for p=1:nx        
        rmse_x_DKF_each(mc,p) = sqrt(mean((Xdkf(p,:) - x_true(p,:)).^2));
        rmse_x_AKF_each(mc,p) = sqrt(mean((Xakf(p,:) - x_true(p,:)).^2));
    end

    %% =====================================================
    % FINAL PARAMETER
    %% =====================================================
    theta_final_DKF(mc,:) = Thdkf(:,end)';
    theta_final_AKF(mc,:) = Thakf(:,end)';
    
end

%% =========================================================
% AVERAGE
%% =========================================================
Xtrue_mean = Xtrue_mean / MC;

Xdkf_mean = Xdkf_mean / MC;
Xakf_mean = Xakf_mean / MC;

Thdkf_mean = Thdkf_mean / MC;
Thakf_mean = Thakf_mean / MC;

%% =========================================================
% FINAL PARAMETER STATISTICS
%% =========================================================
mean_DKF = mean(theta_final_DKF);
std_DKF  = std(theta_final_DKF);

mean_AKF = mean(theta_final_AKF);
std_AKF  = std(theta_final_AKF);

%% =========================================================
% DISPLAY
%% =========================================================

fprintf('\n====================================\n');
fprintf('GLOBAL RMSE STATE\n');
fprintf('====================================\n');
fprintf('SB-DKF : %.4f ± %.4f\n', mean(rmse_x_DKF), std(rmse_x_DKF));
fprintf('AKF    : %.4f ± %.4f\n', mean(rmse_x_AKF), std(rmse_x_AKF));

fprintf('\n====================================\n');
fprintf('GLOBAL RMSE PARAMETER\n');
fprintf('====================================\n');
fprintf('SB-DKF : %.4f ± %.4f\n', mean(rmse_th_DKF), std(rmse_th_DKF));
fprintf('AKF    : %.4f ± %.4f\n', mean(rmse_th_AKF), std(rmse_th_AKF));

fprintf('\n====================================\n');
fprintf('RMSE EACH STATE\n');
fprintf('====================================\n');
for p=1:nx
    fprintf('\nState_%d\n',p);
    fprintf('SB-DKF : %.4f ± %.4f\n', mean(rmse_x_DKF_each(:,p)), std(rmse_x_DKF_each(:,p)));
    fprintf('AKF    : %.4f ± %.4f\n', mean(rmse_x_AKF_each(:,p)), std(rmse_x_AKF_each(:,p)));
end

fprintf('\n====================================\n');
fprintf('RMSE EACH PARAMETER\n');
fprintf('====================================\n');
for p=1:np
    fprintf('\nTheta_%d\n',p);
    fprintf('SB-DKF : %.4f ± %.4f\n', mean(rmse_theta_DKF_each(:,p)), std(rmse_theta_DKF_each(:,p)));
    fprintf('AKF    : %.4f ± %.4f\n', mean(rmse_theta_AKF_each(:,p)), std(rmse_theta_AKF_each(:,p)));
end

fprintf('\n====================================\n');
fprintf('FINAL PARAMETER\n');
fprintf('====================================\n');
for p=1:np
    fprintf('\nTheta_%d True = %.4f\n', p, theta_true(p));
    fprintf('SB-DKF : %.4f ± %.4f\n', mean_DKF(p), std_DKF(p));
    fprintf('AKF    : %.4f ± %.4f\n', mean_AKF(p), std_AKF(p));
end

%%%%%%%%%%%%%%%%%%%%%%%%%%%
fprintf('Improvement State = %.2f %%\n', ...
100*(mean(rmse_x_AKF)-mean(rmse_x_DKF))/mean(rmse_x_AKF));
fprintf('Improvement Parameter = %.2f %%\n', ...
100*(mean(rmse_th_AKF)-mean(rmse_th_DKF))/mean(rmse_th_AKF));

%% =========================================================
% TIME-VARYING RMSE
%% =========================================================
rmse_time_DKF = sqrt(mean((Xdkf_mean - Xtrue_mean).^2,1));
rmse_time_AKF = sqrt(mean((Xakf_mean - Xtrue_mean).^2,1));
rmse_time_th_DKF = sqrt(mean((Thdkf_mean - theta_true_mat).^2,1));
rmse_time_th_AKF = sqrt(mean((Thakf_mean - theta_true_mat).^2,1));
%% =========================================================
